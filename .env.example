# ─── Zyte API ────────────────────────────────────────────────────────────────
ZYTE_API_KEY=your_zyte_api_key_here

# ─── Encryption key for ZKP / GDPR-compliant storage ─────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LEAD_ENCRYPTION_KEY=your_32_byte_hex_key_here

# ─── HMAC signing secret for chain of custody ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CHAIN_HMAC_SECRET=your_hmac_secret_hex_here

# ─── Speech-to-Text API (fallback email deduction via voicemail) ──────────────
# Supported providers: google_cloud | azure | aws_transcribe
STT_PROVIDER=google_cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# ─── Commercial Registry APIs (cross-reference by Plus Code) ──────────────────
# France: SIRENE API (free)
SIRENE_API_BASE_URL=https://api.insee.fr/api-sirene/3.11
SIRENE_API_KEY=your_insee_api_key

# UK: Companies House
COMPANIES_HOUSE_API_KEY=your_companies_house_key

# ─── Output configuration ─────────────────────────────────────────────────────
OUTPUT_DIR=./output
MAX_ITEMS=10000
